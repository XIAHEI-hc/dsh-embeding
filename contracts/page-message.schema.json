{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh:page-bridge:v1",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "dsh.page"
    },
    "version": {
      "const": "1.0"
    },
    "type": {
      "enum": [
        "context.request",
        "context.offer",
        "context.error",
        "context.bound",
        "context.consumed"
      ]
    },
    "channel_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "surface_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol",
    "version",
    "type",
    "channel_id",
    "surface_id",
    "request_id",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "context.request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "native_prompt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "session_id",
              "native_prompt_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "context.offer"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "native_prompt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "display_summary": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "session_id",
              "native_prompt_id",
              "snapshot_id",
              "sha256",
              "display_summary"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "context.error"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "native_prompt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "message": {
                "type": "string",
                "maxLength": 1000
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "session_id",
              "native_prompt_id",
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "context.bound"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "native_prompt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durable_event_seq": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "session_id",
              "native_prompt_id",
              "snapshot_id",
              "sha256",
              "durable_event_seq"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "context.consumed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "native_prompt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "provider_request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "model_input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "session_id",
              "native_prompt_id",
              "snapshot_id",
              "sha256",
              "provider_request_id",
              "model_input_sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
