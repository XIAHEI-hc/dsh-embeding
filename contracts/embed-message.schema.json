{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-embed:message:v1",
  "title": "DSH Embed Message",
  "type": "object",
  "properties": {
    "protocol": { "const": "dsh.embed" },
    "version": { "const": "1.0" },
    "type": {
      "enum": ["ready", "init", "initialized", "session.opened", "session.lifecycle", "connection.changed", "draft_prompt", "draft_prompt.result", "selected_skills", "sync_skills", "skills.synced", "error"]
    },
    "channel_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "payload": { "type": "object" }
  },
  "required": ["protocol", "version", "type", "channel_id", "request_id", "payload"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "ready" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "capabilities": { "type": "array", "items": { "type": "string" } },
              "auth_required": { "type": "boolean" }
            },
            "required": ["capabilities", "auth_required"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "init" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "ticket": { "type": "string", "minLength": 32, "maxLength": 4096 },
              "initial_prompt": { "type": "string", "maxLength": 8000 }
            },
            "required": ["ticket"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "initialized" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "workspace_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "session_id": { "type": ["string", "null"] },
              "mode": { "enum": ["read_write", "preview_only"] },
              "capabilities": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["workspace_id", "session_id", "mode", "capabilities"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "session.opened" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "workspace_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "session_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": ["workspace_id", "session_id"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "session.lifecycle" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "action": { "enum": ["forked", "deleted", "archived", "unarchived"] },
              "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "parent_session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "context_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": ["action", "session_id"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "connection.changed" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "state": { "enum": ["connected", "reconnecting", "disconnected", "auth_required"] }
            },
            "required": ["state"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "draft_prompt" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "prompt": { "type": "string", "maxLength": 8000 },
              "command_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": ["prompt", "command_id"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "draft_prompt.result" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "command_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "applied": { "type": "boolean" },
              "reason": { "enum": ["session_unavailable", "draft_not_empty"] }
            },
            "required": ["command_id", "applied"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "selected_skills" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "skills": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "runtime_name": { "type": "string", "pattern": "^ml-[a-z0-9-]+$", "maxLength": 200 }
                  },
                  "required": ["name", "runtime_name"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["skills"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "sync_skills" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "properties": {
        "command_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }, "required": ["command_id"], "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "skills.synced" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "properties": {
        "command_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime_names": { "type": "array", "items": { "type": "string", "pattern": "^ml-[a-z0-9-]+$", "maxLength": 200 } },
        "error": { "type": "string", "maxLength": 128 }
      }, "required": ["command_id", "runtime_names"], "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "error" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string", "maxLength": 1000 },
              "retryable": { "type": "boolean" },
              "action": { "type": "string" }
            },
            "required": ["code", "message", "retryable", "action"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
