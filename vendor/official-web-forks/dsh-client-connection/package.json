{
  "name": "@deepseek-ai/dsh-client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.2.0-rc.2",
  "workbenchFork": {
    "upstreamTag": "dsh-v0.2.0-rc.2",
    "upstreamCommit": "639ed015397290b3745d163aafe02ffee4aa3f84",
    "purpose": "Expose trust-checked browser session issuance and configurable Secure cookies"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2"
  }
}
