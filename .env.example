DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-v4-flash
DSH_PROFILE=sdk
DSH_PATCHES=
WORKBENCH_DATA_DIR=./data
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKBENCH_TOKEN=
# SDK 权限模式。容器部署保持 danger-full-access：镜像内没有 bubblewrap/Landlock，
# 用 workspace-write 会让容器内所有 bash 调用失败。详见 README 第 5 节。
DSH_PERMISSION_MODE=danger-full-access
WORKBENCH_PORT=8765
WORKBENCH_RUN_TIMEOUT=900
