DEEPSEEK_API_KEY=
# 官方 Web 使用 Anthropic Messages 协议；通常无需覆盖默认地址。
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DSH_MODEL=deepseek-v4-flash
DSH_PROFILE=sdk
DSH_PATCHES=
WORKBENCH_DATA_DIR=./data
# 仅旧版 SDK API 使用。官方 Web 用启动时生成的 token/cookie，不需要此字段。
WORKBENCH_TOKEN=
# SDK 权限模式。容器部署保持 danger-full-access：镜像内没有 bubblewrap/Landlock，
# 用 workspace-write 会让容器内所有 bash 调用失败。详见 README。
# 本地默认保留官方安全策略；Compose 已显式设置容器内权限。
# DSH_PERMISSION_MODE=danger-full-access
WORKBENCH_PORT=8765
WORKBENCH_RUN_TIMEOUT=900

# 默认与 WORKBENCH_PORT 对应的 localhost 地址；Docker 改外部端口时无需设置。
# WORKBENCH_PUBLIC_URL=http://localhost:8765
# WORKBENCH_WEB_HOME=./data/web/dsh-home
# WORKBENCH_WEB_WORKSPACE=./data/web/workspace
