DEEPSEEK_API_KEY=
# 官方 Web 使用 Anthropic Messages 协议；通常无需覆盖默认地址。
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DSH_MODEL=deepseek-v4-flash
DSH_PROFILE=sdk
DSH_PATCHES=
WORKBENCH_DATA_DIR=./data
# 仅旧版 SDK API 使用。官方 Web 用启动时生成的 token/cookie，不需要此字段。
WORKBENCH_TOKEN=
# SDK 权限模式。容器部署保持 danger-full-access：镜像内没有 bubblewrap/Landlock，
# 用 workspace-write 会让容器内所有 bash 调用失败。详见 README。
# 本地默认保留官方安全策略；Compose 已显式设置容器内权限。
# DSH_PERMISSION_MODE=danger-full-access
WORKBENCH_PORT=8765
WORKBENCH_RUN_TIMEOUT=900

# 默认与 WORKBENCH_PORT 对应的 localhost 地址；Docker 改外部端口时无需设置。
# WORKBENCH_PUBLIC_URL=http://localhost:8765
# WORKBENCH_WEB_HOME=./data/web/dsh-home
# WORKBENCH_WEB_WORKSPACE=./data/web/workspace

# Optional registered workspaces. Every configured directory must already exist.
# WORKBENCH_WORKSPACE_CONFIG=./config/workspaces.json

# Same-site iframe embedding is disabled by default.
WORKBENCH_EMBED_ENABLED=false
# WORKBENCH_EMBED_CONFIG=./config/embed.json
# WORKBENCH_EMBED_STATE=./data/web/dsh-home/extensions/embed.sqlite3
# The embed config references this server-only value through secret_env.
# DSH_EMBED_PORTAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Memory Lab 专用 DSH 实例。不要与 PROBE_AI_INTEGRATION_ENABLED 同时启用。
# MEMORYLAB_AI_INTEGRATION_ENABLED=true
# MEMORYLAB_AI_DSH_INSTANCE_ID=memorylab-local-dsh
# MEMORYLAB_AI_API_ORIGIN=http://memorylab-backend:9000
# MEMORYLAB_AI_PUBLIC_ORIGIN=http://127.0.0.1:7890
# MEMORYLAB_AI_TOOL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# MEMORYLAB_AI_INTEGRATION_STATE=/data/memorylab-integration.sqlite3
# MEMORYLAB_AI_TOOL_TIMEOUT_MS=120000
# MEMORYLAB_AI_MAX_UPLOAD_BYTES=104857600
